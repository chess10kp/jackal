#!/usr/bin/env bash
# Run the pre-built TUI binary (no neojac).
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export JACKAL_ROOT="$REPO_ROOT"
export JACKAL_AGENT_DIR="${JACKAL_AGENT_DIR:-$REPO_ROOT/pi}"
BIN="$REPO_ROOT/app/.jac/bin/jackal-tui"
if [[ ! -x "$BIN" ]]; then
  echo "missing $BIN — build once: cd $REPO_ROOT/app && neojac build tui/shell.jac -o .jac/bin/jackal-tui --release" >&2
  exit 127
fi
exec "$BIN" "$@"
