obj LiveShell {
    has session: UiSession,
        shell: any,
        normalizer: any,
        proj: TranscriptProjection,
        renderer: Renderer,
        term: ProcessTerminal,
        progress: ProgressBar,
        messages: list[TranscriptMessage] = [],
        rev: int = 0,
        msg_n: int = 0,
        phase: str = "ready",
        progress_value: float = 0.0,
        stream_full: str = "",
        stream_shown: int = 0,
        stream_msg_id: str = "",
        stream_tick: int = 0,
        spin_i: int = 0,
        running: bool = True,
        dirty: bool = True,
        columns: int = 80,
        rows: int = 24,
        status_hint: str = "enter · ↑↓ history · esc quit";
}

def make_live_shell(
    session: UiSession,
    shell: any,
    proj: TranscriptProjection,
    renderer: Renderer,
    term: ProcessTerminal,
    normalizer: any,
    progress: ProgressBar,
    columns: int,
    rows: int,
) -> LiveShell;
